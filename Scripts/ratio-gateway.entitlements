<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ratio-gateway runs as a supervised sibling process inside Rational.app.

  Narrower than pie-engine.entitlements on purpose: the gateway executes no
  wasm and JITs nothing, so it needs neither allow-jit nor
  allow-unsigned-executable-memory. It only binds a loopback listener
  (network.server) and dials the engine's WebSocket (network.client).
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.network.client</key>
    <true/>
    <key>com.apple.security.network.server</key>
    <true/>
</dict>
</plist>
